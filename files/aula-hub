#!/bin/bash
# AULA Hub on Linux (unofficial launcher).
# Offline by default: a private network namespace means the app can't download
# firmware or remote UI updates. AULA_ONLINE=1 aula-hub allows network.
DATA_DIR="@DATA_DIR@"
APP="$DATA_DIR/app"

if [ -x "$DATA_DIR/electron/electron" ]; then
    ELECTRON="$DATA_DIR/electron/electron"
elif command -v electron40 >/dev/null; then
    ELECTRON=$(command -v electron40)
else
    echo "aula-hub: Electron 40 not found. Re-run install.sh." >&2
    exit 1
fi

FLAGS=(--ozone-platform-hint=auto)

if [ "${AULA_ONLINE:-0}" = 1 ]; then
    cat >&2 <<'EOF'
aula-hub: WARNING: AULA_ONLINE=1 turns OFF the network sandbox.
  The app can now contact AULA's servers. Firmware updates are still blocked by
  patch, but that patch is then the only safety layer. Use this only to debug
  startup problems, and start the app normally (plain "aula-hub") afterwards.
EOF
    exec "$ELECTRON" "${FLAGS[@]}" "$APP" "$@"
fi

if ! unshare --user --map-current-user --net -- true 2>/dev/null; then
    cat >&2 <<'EOF'
aula-hub: this system doesn't allow the offline sandbox (unprivileged user namespaces).
  On Ubuntu 24.04+ / Mint 22+ / Pop!_OS 24+: re-run install.sh with --system.
  To start it anyway without the sandbox (see the README first):
    AULA_ONLINE=1 aula-hub
EOF
    exit 1
fi
exec unshare --user --map-current-user --net -- "$ELECTRON" "${FLAGS[@]}" "$APP" "$@"
